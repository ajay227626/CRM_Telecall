# MongoDB Atlas Cluster0 (Universal Ecosystem Database)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.shcnisx.mongodb.net/crm_production?retryWrites=true&w=majority&appName=Cluster0
MONGODB_DB_NAME=crm_production
MONGODB_MAX_POOL_SIZE=10

# Server Port
PORT=8000

# Central SLM Identity Provider (OIDC + PKCE)
SLM_BASE_URL=https://app.ajaywebservices.in
SLM_ISSUER=https://app.ajaywebservices.in
SLM_OIDC_CLIENT_ID=client_telecall_crm
SLM_CLIENT_ID=client_telecall_crm
SLM_OIDC_CLIENT_SECRET=
SLM_CLIENT_SECRET=
SLM_OIDC_REDIRECT_URI=https://crm.ajaywebservices.in/api/auth/oidc/callback
SLM_REDIRECT_URI=https://crm.ajaywebservices.in/api/auth/oidc/callback

# Session & Security
JWT_SECRET=crm_telecaller_session_secret_key_2024_secure_random_string
COOKIE_SECURE=true
FRONTEND_URL=https://crm.ajaywebservices.in

# Central App Hub Ecosystem URL
APP_HUB_URL=https://apps.ajaywebservices.in
